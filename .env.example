# Copy this file to .env and keep real credentials out of Git.

# Chat model: Google Gemini (same model used by the Google_ADK workspace)
LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite

# Local CPU embeddings (no Google embedding API call and no Ollama server required)
EMBEDDING_PROVIDER=sentence-transformers
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional alternative providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=all-minilm

# Optional LangSmith tracing/evaluation.
# Set LANGSMITH_TRACING=true and provide a LangSmith API key to capture
# LangGraph runs, nested LangChain chains, and actual Gemini model calls.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ORGANIZATION_ID=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT=ai-helpdesk-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

TEMPERATURE=0
